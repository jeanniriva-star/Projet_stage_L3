{
  
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "lib": ["ES2022"],
    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "resolveJsonModule": true,

    "noUncheckedIndexedAccess": true
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}